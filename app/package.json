{
  "name": "movienight-app",
  "version": "0.1.0",
  "private": true,
  "description": "Netflix-style desktop client for movienight (Electron + React)",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "fixtures:gen": "node e2e/fixtures/generate-fixtures.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:server": "MOVIE_DIR=./e2e/fixtures/movies DATA_DIR=./e2e/fixtures/.data PORT=1234 HOST=127.0.0.1 node ../server/src/index.js",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "web": "vite"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "vite": "^5.4.11"
  }
}
